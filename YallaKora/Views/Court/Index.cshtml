@model List<Court>

@{
    ViewData["Title"] = "YallaKora - Courts";

   
    int? currentUserId = Context.Session.GetInt32("UserId");
    string currentUserRole = Context.Session.GetString("UserRole");
    bool isAdmin = (currentUserRole == "Admin");
}

<style>
   
    .court-card {
        background-color: #111827;
        border: 1px solid #1f2937;
        border-radius: 16px;
        transition: all 0.3s ease-in-out;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

        .court-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(59, 130, 246, 0.2);
            border-color: #3b82f6;
        }

    .court-img-container {
        overflow: hidden;
        height: 220px;
    }

    .court-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .court-card:hover .court-img {
        transform: scale(1.08);
    }

    .price-badge {
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        color: white;
        font-weight: bold;
    }
</style>

<div class="container py-5 text-white">
    
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold display-5 text-gradient">⚽ Our Courts</h2>
            <p class="text-muted">Book now and enjoy playing with your friends</p>
        </div>

        @if (isAdmin)
        {
            <a asp-controller="Court" asp-action="Add" class="btn btn-success px-4 py-2 rounded-pill fw-bold shadow-sm">
                ➕ Add New Court
            </a>
        }
    </div>

    <div class="row g-4 justify-content-center">
        @foreach (var crt in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card court-card h-100 text-white">

                    <div class="court-img-container">
                        <img src="~/Assets/@crt.CourtImage" class="court-img" alt="@crt.CourtName">
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h4 class="card-title fw-bold text-light mb-3">@crt.CourtName</h4>
                        <p class="card-text text-muted small flex-grow-1">@crt.Description</p>

                        <div class="d-flex justify-content-between align-items-center mt-3 mb-3">
                            <span class="badge price-badge px-3 py-2 fs-6 rounded-pill">
                                @crt.PricePerHour L.E / hr
                            </span>

                            <a asp-controller="Booking" asp-action="BookingType" asp-route-courtId="@crt.CourtId" class="btn btn-outline-primary btn-sm px-3 rounded-pill fw-bold">
                                Book Now 🚀
                            </a>
                        </div>

                        @if (isAdmin)
                        {
                            <div class="border-top border-secondary pt-3 mt-2 d-flex justify-content-between align-items-center">
                                <a asp-controller="Court" asp-action="Edit" asp-route-id="@crt.CourtId" class="btn btn-sm btn-warning fw-semibold px-3 rounded-pill text-dark">
                                    ✏️ Edit
                                </a>

                                <form asp-controller="Court" asp-action="Delete" asp-route-id="@crt.CourtId" method="post" onsubmit="return confirm('Are you sure you want to delete this court?');" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-danger fw-semibold px-3 rounded-pill">
                                        🗑️ Delete
                                    </button>
                                </form>
                            </div>
                        }
                    </div>

                </div>
            </div>
        }
    </div>
</div>