@model Court
@{
    ViewData["Title"] = "Add Court";
}

<div class="container py-5 text-white col-md-6">
    <h2 class="mb-4">➕ Add New Court</h2>
    <form asp-action="Add" method="post" enctype="multipart/form-data" class="bg-dark p-4 rounded shadow">
        <div class="mb-3">
            <label class="form-label">Court Name</label>
            <input asp-for="CourtName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Price Per Hour</label>
            <input asp-for="PricePerHour" class="form-control" type="number" required />
        </div>
        <div class="mb-4">
            <label class="form-label">Court Image</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" required />
        </div>
        <button type="submit" class="btn btn-success w-100 fw-bold">Save Court</button>
    </form>
</div>