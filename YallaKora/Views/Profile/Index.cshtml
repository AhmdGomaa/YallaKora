
@model YallaKora.Models.User


@{
    ViewData["Title"] = "Player Profile";
    var Reviews = ViewData["Reviews"] as List<Review>;
    var UserReviews = ViewData["UserReviews"] as List<User>;

    int? currentUserId = Context.Session.GetInt32("UserId");
    string currentUserRole = Context.Session.GetString("UserRole");

    bool isOwnerOrAdmin = (currentUserId != null && currentUserId == Model.UserId) || (currentUserRole == "Admin");

}

<style>
    body {
        background-color: #0b0f19 !important;
        color: #e6edf3 !important;
    }

    .profile-card {
        background-color: #111827;
        border: 1px solid #1f2937;
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    }

    .profile-header {
        background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
        border-bottom: 1px solid #374151;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        position: relative;
    }

    .avatar-wrapper {
        position: relative;
        display: inline-block;
    }

    .avatar-img {
        width: 140px;
        height: 140px;
        object-fit: cover;
        border: 4px solid #374151;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
    }

    .info-tile {
        background-color: #1f2937;
        border: 1px solid #374151;
        border-radius: 14px;
        padding: 18px;
        transition: all 0.3s ease;
    }

        .info-tile:hover {
            border-color: #3b82f6;
            transform: translateY(-3px);
        }

    .role-badge {
        background-color: #f59e0b !important;
        color: #000000 !important;
        font-weight: 800 !important;
    }

    .position-badge {
        background-color: #2563eb !important;
        color: #ffffff !important;
        font-weight: 700 !important;
    }

    .review-section {
        background-color: #111827;
        border: 1px solid #1f2937;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.5);
    }

    .form-control-dark {
        background-color: #1f2937 !important;
        border: 1px solid #374151 !important;
        color: #e6edf3 !important;
        border-radius: 10px;
        padding: 12px;
    }

        .form-control-dark:focus {
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25) !important;
            color: #fff !important;
        }

    .star-rating {
        direction: rtl;
        display: inline-flex;
        font-size: 2rem;
        cursor: pointer;
    }

        .star-rating input {
            display: none;
        }

        .star-rating label {
            color: #4b5563;
            transition: color 0.2s ease;
        }

            .star-rating input:checked ~ label,
            .star-rating label:hover,
            .star-rating label:hover ~ label {
                color: #f59e0b;
            }

    .review-card {
        background-color: #1f2937;
        border: 1px solid #374151;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 15px;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card profile-card mb-5">

                <div class="profile-header p-5 text-center">

                    <div class="position-absolute top-0 end-0 m-4">
                        <span class="badge role-badge px-3 py-2 rounded-pill shadow-sm">
                            ⚡ @Model.Role
                        </span>
                    </div>

                    <div class="avatar-wrapper mb-3">
                        <img src="@(!string.IsNullOrEmpty(Model.ProfileImage) ? Model.ProfileImage : "/images/default-avatar.png")"
                             class="rounded-circle avatar-img"
                             alt="Profile Picture" />
                    </div>

                    <h2 class="fw-bold text-white mb-1">@Model.FirstName @Model.LastName</h2>
                    <p class="text-muted mb-3">@@@Model.UserName</p>

                    <div>
                        <span class="badge position-badge px-4 py-2 rounded-pill shadow-sm">
                            ⚽ Position: @Model.UserPosition
                        </span>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <h5 class="text-secondary fw-bold mb-4 text-uppercase fs-6">📋 Player Information</h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="info-tile">
                                <span class="d-block text-muted small mb-1">First Name</span>
                                <span class="fw-semibold text-white fs-6">@Model.FirstName</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-tile">
                                <span class="d-block text-muted small mb-1">Last Name</span>
                                <span class="fw-semibold text-white fs-6">@Model.LastName</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-tile">
                                <span class="d-block text-muted small mb-1">Age</span>
                                <span class="fw-semibold text-white fs-6">@Model.Age Years Old</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-tile">
                                <span class="d-block text-muted small mb-1">Phone Number</span>
                                <span class="fw-semibold text-white fs-6">@Model.PhoneNumber</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="info-tile">
                                <span class="d-block text-muted small mb-1">Email Address</span>
                                <span class="fw-semibold text-white fs-6">@Model.Email</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="info-tile">
                                <span class="d-block text-muted small mb-1">Address</span>
                                <span class="fw-semibold text-white fs-6">@Model.Address</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-transparent border-0 text-center pb-4 d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light px-4 py-2 rounded-pill fw-semibold">
                        ← Back to Home
                    </a>

                    @if (isOwnerOrAdmin)
                    {
                        <a asp-controller="Profile" asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-warning px-4 py-2 rounded-pill fw-bold text-dark">
                            ✏️ Edit Profile
                        </a>

                        <form asp-controller="Profile" asp-action="Delete" asp-route-id="@Model.UserId" method="post" onsubmit="return confirm('Are you sure you want to delete this profile?');" class="d-inline">
                            <button type="submit" class="btn btn-danger px-4 py-2 rounded-pill fw-bold">
                                🗑️ Delete Profile
                            </button>
                        </form>
                    }
                </div>
            </div>

            <div class="review-section">
                <h3 class="fw-bold text-white mb-3">⭐ Player Reviews & Ratings</h3>
                <p class="text-muted small mb-4">Share your experience playing with this player and leave a rating.</p>

                <form asp-controller="Profile" asp-action="Review" asp-route-id="@Model.UserId" method="post" class="mb-5">

                    <input type="hidden" name="id" value="@Model.UserId" />

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Select Rating (1 to 5 Stars)</label>
                        <div class="star-rating">
                            <input type="radio" id="star5" name="Rating" value="5" /><label for="star5" title="5 stars">★</label>
                            <input type="radio" id="star4" name="Rating" value="4" /><label for="star4" title="4 stars">★</label>
                            <input type="radio" id="star3" name="Rating" value="3" /><label for="star3" title="3 stars">★</label>
                            <input type="radio" id="star2" name="Rating" value="2" /><label for="star2" title="2 stars">★</label>
                            <input type="radio" id="star1" name="Rating" value="1" /><label for="star1" title="1 star">★</label>
                        </div>
                    </div>

                    <div class="classes mb-3">
                        <label class="form-label text-muted small fw-bold">Your Comment</label>
                        <textarea name="Comment" class="form-control form-control-dark" rows="3" placeholder="Write your feedback about this player..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary px-4 py-2 fw-bold rounded-pill">Submit Review</button>
                </form>
                <hr class="border-secondary my-4" />
                @if (Reviews == null || !Reviews.Any())
                {
                    <h5 class="fw-bold text-white mb-3">No Reviews Yet</h5>
                }
                else
                {

                    <h5 class="fw-bold text-white mb-3">Recent Reviews</h5>
                    @foreach (var review in Reviews)
                    {
                        var reviewer = UserReviews?.FirstOrDefault(u => u.UserId == review.FromUserId);
                        string reviewerName = reviewer != null ? reviewer.UserName : "Unknown User";

                        <div class="review-card">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-primary">
                                    @reviewerName
                                </span>
                                <span class="text-warning">
                                    @for (int i = 0; i < review.Rating; i++)
                                    {
                                        <text>★</text>
                                    }
                                </span>
                            </div>
                            <p class="text-muted small mb-0">
                                @review.Comment
                            </p>
                        </div>
                    }
                }
                
                

                

                

            </div>

        </div>
    </div>
</div>