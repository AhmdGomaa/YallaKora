@model IEnumerable<YallaKora.Models.User>

@{
    ViewData["Title"] = "Our Users";
}

<style>
    body {
        background-color: #0b0f19 !important;
        color: #e6edf3 !important;
    }

    .user-card {
        background-color: #111827;
        border: 1px solid #1f2937;
        border-radius: 16px;
        transition: all 0.3s ease;
        text-decoration: none !important;
        display: block;
        height: 100%;
    }

        .user-card:hover {
            border-color: #3b82f6;
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.15);
        }

    .avatar-sm {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border: 3px solid #374151;
    }

    .role-badge {
        background-color: #f59e0b !important;
        color: #000000 !important;
        font-weight: 700 !important;
        font-size: 0.75rem;
    }

    .position-badge {
        background-color: #2563eb !important;
        color: #ffffff !important;
        font-weight: 600 !important;
        font-size: 0.75rem;
    }
</style>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-white mb-2">⚽ Our Players & Users</h1>
        <p class="text-muted">Explore all registered players, check their positions, and view their profiles.</p>
    </div>

    <div class="row g-4">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12 text-center py-5">
                <h4 class="text-muted">No users found yet.</h4>
            </div>
        }
        else
        {
            @foreach (var user in Model)
            {
                @if (!string.IsNullOrEmpty(user.UserName) || !string.IsNullOrEmpty(user.FirstName))
                {
                    <div class="col-md-4 col-sm-6">
                        <a asp-controller="Profile" asp-action="Index" asp-route-id="@user.UserId" class="user-card p-4">
                            <div class="d-flex align-items-center mb-3">
                                <img src="@(!string.IsNullOrEmpty(user.ProfileImage) ? user.ProfileImage : "/images/default-avatar.png")"
                                     class="rounded-circle avatar-sm me-3" alt="Avatar" />
                                <div>
                                    <h5 class="fw-bold text-white mb-1">@user.FirstName @user.LastName</h5>
                                    <p class="text-muted small mb-0">@@@user.UserName</p>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top border-secondary border-opacity-25">
                                <span class="badge position-badge px-3 py-1 rounded-pill">
                                    @(!string.IsNullOrEmpty(user.UserPosition) ? user.UserPosition : "Player")
                                </span>
                                <span class="badge role-badge px-3 py-1 rounded-pill">
                                    @user.Role
                                </span>
                            </div>
                        </a>
                    </div>
                }
            }
        }
    </div>

    <div class="text-center mt-5">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light px-5 py-2 rounded-pill fw-semibold">
            ← Back to Home
        </a>
    </div>
</div>