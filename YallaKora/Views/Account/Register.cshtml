@model User
@{
    ViewData["Title"] = "Register Page";
}

<h2 class="align-content-center" >Register Now To Join Us </h2>
<hr>

<form class="container align-content-center" enctype="multipart/form-data" method="post" asp-controller="Account" asp-action="Register" data--h-bstatus="0OBSERVED">
    <fieldset data--h-bstatus="0OBSERVED">
        <div class="col-sm-3 my-1">
            <label class="sr-only" >Firstname</label>
            <input type="text" name="FirstName" class="form-control" placeholder="Enter Firstname">
            <span asp-validation-for="FirstName"></span>
           
        </div>
        <div class="col-sm-3 my-1">
            <label class="sr-only" >Lastname</label>
            <input type="text" name="LastName" class="form-control" placeholder="Enter Lastname">
            <span asp-validation-for="LastName" class="text-bg-danger"></span>
         
        </div>

        <div class="col-sm-3 my-1">
            <label class="sr-only">UserName</label>
            <input type="text" name="UserName" class="form-control" placeholder="Enter Username">
            <span asp-validation-for="UserName" class="text-bg-danger"></span>
            
        </div>
        <div class="col-sm-3 my-1">
            <label class="sr-only" >Age</label>
            <input type="number" name="Age" class="form-control" placeholder="Enter your age">
            <span asp-validation-for="Age" class="text-bg-danger"></span>
            
           
        </div>
        <div class="col-sm-3 my-1">
            <label class="sr-only" >Address</label>
            <input type="text" name="Address" class="form-control" placeholder="Enter your Addres">
            <span asp-validation-for="Address" class="text-bg-danger"></span>
            
        </div>
        <div class="col-sm-3 my-1">
            <label class="sr-only" >Phonenumber</label>
            <input type="text" name="PhoneNumber" class="form-control" placeholder="Enter your number">
            <span asp-validation-for="PhoneNumber" class="text-bg-danger"></span>
          
        </div>
        
        
        
        
        <div data--h-bstatus="0OBSERVED">
            <label  class="form-label mt-4" data--h-bstatus="0OBSERVED">Your Position</label>
            <select name="UserPosition" class="form-select" id="exampleSelect1" data--h-bstatus="0OBSERVED">
                <option data--h-bstatus="0OBSERVED">Goalkeeper</option>
                <option data--h-bstatus="0OBSERVED">Defender</option>
                <option data--h-bstatus="0OBSERVED">midfielder</option>
                <option data--h-bstatus="0OBSERVED">Attacker</option>
                <option data--h-bstatus="0OBSERVED">Joker</option>
            </select>
        </div>
       
        <div data--h-bstatus="0OBSERVED">
            <label  class="form-label mt-4" data--h-bstatus="0OBSERVED">Enter Your Picture</label>
            <input name ="ProfileImage" class="form-control" type="file" data--h-bstatus="0OBSERVED">
            <small id="emailHelp" class="form-text text-muted" data--h-bstatus="0OBSERVED">Only .jpes   .jpg and  .png files are allowed with max 1mb</small>
            <span asp-validation-for="ProfileImage" class="text-bg-danger"></span>
        </div>
       
        
       
        <div data--h-bstatus="0OBSERVED">
            <label  class="form-label mt-4" data--h-bstatus="0OBSERVED">Email </label>
            <input name="Email" type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="Enter email" data--h-bstatus="0OBSERVED">
            <small id="emailHelp" class="form-text text-muted" data--h-bstatus="0OBSERVED">We'll never share your email with anyone else.</small>
            <span asp-validation-for="Email" class="text-bg-danger"></span>
            

        </div>
        <div class="mb-5" data--h-bstatus="0OBSERVED">
            <label class="form-label mt-4" data--h-bstatus="0OBSERVED">Password</label>
            <input name="Password" type="password" class="form-control" id="exampleInputPassword1" placeholder="Password" autocomplete="off" data--h-bstatus="0OBSERVED">
           
            <small id="emailHelp" class="form-text text-muted" data--h-bstatus="0OBSERVED">the password should be more tha 6 characters and less than 30 characters</small>
            <span asp-validation-for="Password" class="text-bg-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary" data--h-bstatus="0OBSERVED">Submit</button>
    </fieldset>
</form>