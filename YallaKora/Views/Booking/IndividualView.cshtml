@model List<YallaKora.Models.SlotPlayer>
@{
    ViewData["Title"] = "5v5 Match Pitch & Players";
    var currentSlot = ViewData["CurrentSlot"] as YallaKora.Models.Slot;
    int currentUserId = Context.Session.GetInt32("UserId") ?? 0;
}

<style>
   
    .pitch-container {
        width: 100%;
        max-width: 450px; 
        aspect-ratio: 1 / 1.75; 
        background: url('/assets/IndividualCourt.jpg') no-repeat center center;
        background-size: cover; 
        position: relative;
        margin: 0 auto;
        border: 4px solid #1f2937;
        border-radius: 15px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.7);
    }

    .pos-node {
        position: absolute;
        width: 90px;
        text-align: center;
        transform: translate(-50%, -50%);
    }

    .player-circle {
        width: 50px;
        height: 50px;
        background-color: #111827;
        border: 2px solid #ffffff;
        border-radius: 50%;
        margin: 0 auto 3px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0,0,0,0.3);
    }

        .player-circle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .player-name {
        font-size: 0.75rem;
        color: #ffffff;
        font-weight: bold;
        background: rgba(0, 0, 0, 0.7);
        padding: 1px 4px;
        border-radius: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 90px;
        margin-bottom: 2px;
    }

    .btn-action {
        font-size: 0.65rem;
        padding: 2px 6px;
        border-radius: 12px;
        font-weight: bold;
    }
</style>

<div class="container-fluid py-4">
    <div class="text-center mb-4">
        <h3 class="fw-bold text-white">⚽ 5v5 Match Management</h3>
        <p class="text-muted small">Interactive pitch on the left and joined players list on the right.</p>
    </div>

    <div class="row justify-content-center align-items-start">

      
        <div class="col-lg-7 col-md-12 d-flex justify-content-center mb-4">
            <div class="pitch-container">
                @{
                    var positions = new[] {
                        new { Key = "Home_GK", Name = "GK", Top = "90%", Left = "50%" },
                        new { Key = "Home_CB", Name = "CB", Top = "75%", Left = "50%" },
                        new { Key = "Home_LB", Name = "LB", Top = "75%", Left = "20%" },
                        new { Key = "Home_RB", Name = "RB", Top = "75%", Left = "80%" },
                        new { Key = "Home_ST", Name = "ST", Top = "60%", Left = "50%" },

                        new { Key = "Away_ST", Name = "ST", Top = "40%", Left = "50%" },
                        new { Key = "Away_LB", Name = "LB", Top = "25%", Left = "20%" },
                        new { Key = "Away_RB", Name = "RB", Top = "25%", Left = "80%" },
                        new { Key = "Away_CB", Name = "CB", Top = "25%", Left = "50%" },
                        new { Key = "Away_GK", Name = "GK", Top = "10%", Left = "50%" }
                    };
                }

                @foreach (var pos in positions)
                {
                    var existingPlayer = Model.FirstOrDefault(sp => sp.Position == pos.Key);

                    <div class="pos-node" style="top: @pos.Top; left: @pos.Left;">
                        <div class="player-circle">
                            @if (existingPlayer != null && existingPlayer.User != null)
                            {
                                <img src="@existingPlayer.User.ProfileImage" alt="Player" />
                            }
                            else
                            {
                                <span class="text-muted small">@pos.Name</span>
                            }
                        </div>

                        @if (existingPlayer != null && existingPlayer.User != null)
                        {
                            <div class="player-name">@existingPlayer.User.UserName</div>
                            <a asp-controller="Profile" asp-action="Index" asp-route-id="@existingPlayer.UserId"
                               class="btn btn-sm btn-info text-white py-0 px-1 mb-1" style="font-size: 0.6rem;">Profile</a>

                            @if (existingPlayer.UserId == currentUserId)
                            {
                                <form asp-action="LeaveSlot" method="post">
                                    <input type="hidden" name="slotPlayerId" value="@existingPlayer.SlotPlayerId" />
                                    <input type="hidden" name="slotId" value="@currentSlot?.SlotId" />
                                    <button type="submit" class="btn btn-action btn-danger w-100">Leave</button>
                                </form>
                            }
                        }
                        else
                        {
                            <div class="text-white small fw-bold mb-1" style="font-size: 0.7rem;">@pos.Name</div>
                            <form asp-action="JoinSlot" method="post">
                                <input type="hidden" name="position" value="@pos.Key" />
                                <input type="hidden" name="slotId" value="@currentSlot?.SlotId" />
                                <button type="submit" class="btn btn-action btn-primary w-100">Join</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>

        
        <div class="col-lg-4 col-md-12">
            <div class="card bg-dark text-white border-secondary shadow-lg p-3">
                <h5 class="fw-bold mb-3 border-bottom pb-2 text-primary">📋 Joined Players (@Model.Count / 10)</h5>

                @if (Model.Count == 0)
                {
                    <p class="text-muted small text-center py-4">No players have joined yet. Be the first!</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0">
                            <thead>
                                <tr class="text-muted small">
                                    <th>Player</th>
                                    <th>Position</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sp in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@sp.User.ProfileImage" class="rounded-circle me-2" width="30" height="30" style="object-fit: cover;" />
                                                <span class="small fw-bold">@sp.User.UserName</span>
                                            </div>
                                        </td>
                                        <td><span class="badge bg-secondary">@sp.Position?.Replace("Home_", "").Replace("Away_", "")</span></td>
                                        <td>
                                            <a asp-controller="Profile" asp-action="Index" asp-route-id="@sp.UserId" class="btn btn-sm btn-outline-info py-0 px-2" style="font-size: 0.7rem;">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        

    </div>
</div>