@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YallaKora</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/YallaKora.styles.css" asp-append-version="true" />
    <link rel="icon" href="https://fav.farm/⚽" />
</head>
<body>
    
            <header>
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                    <div class="container-fluid">
                        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">YallaKora</a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Court" asp-action="index">Courts</a>
                                </li>
                            @if (Context.Session.GetString("UserName") != null)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Booking" asp-action="BookingType">Booking</a>
                                </li>
                            }
                            else
                            {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Booking</a>
                            </li>
                            }
                            <li class="nav-item dropdown" data--h-bstatus="0OBSERVED">
                                    <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false" data--h-bstatus="0OBSERVED">Account</a>
                                        
                                    <div class="dropdown-menu" data--h-bstatus="0OBSERVED">
                                @if (Context.Session.GetString("UserName") != null)
                                    {
                                        
                                    <a asp-controller="Account" asp-action="Logout" class="dropdown-item">Logout</a>
                                    <div class="dropdown-divider" data--h-bstatus="0OBSERVED"></div>
                                    <a class="dropdown-item" data--h-bstatus="0OBSERVED" asp-controller="Profile" asp-action="Index">Profile Info</a>
                                    }
                                    else
                                    {
                                    <a class="dropdown-item" data--h-bstatus="0OBSERVED" asp-controller="Account" asp-action="Login">Login</a>
                                    <a class="dropdown-item" data--h-bstatus="0OBSERVED" asp-controller="Account" asp-action="Register">Register</a>
                                    }
                                        
                                    </div>
                            </li>
                                @if (Context.Session.GetString("UserName") != null)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link">Welcome, @Context.Session.GetString("UserName")</a>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <a asp-controller="Account" asp-action="Login" class="nav-link">Login</a>
                                    </li>
                                }

                            </ul>
                        </div>
                    </div>
                </nav>
            </header>
        
        <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
       
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
